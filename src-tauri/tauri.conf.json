{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Установщик кириллицы для Deep Rock Galactic",
  "version": "0.1.0",
  "identifier": "ru.xllifi.drg-ru",
  "build": {
    "beforeDevCommand": "yarn dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "yarn build",
    "frontendDist": "../build"
  },
  "app": {
    "windows": [
      {
        "title": "Установщик кириллицы для Deep Rock Galactic",
        "width": 500,
        "height": 300,
        "minWidth": 400,
        "minHeight": 200
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "msi",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
